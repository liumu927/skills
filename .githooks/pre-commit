#!/bin/sh
# 提交闸门：拦住含组织内部实值的文件入库。
# 安装：git config core.hooksPath .githooks
# 绕过：git commit --no-verify（仅在你确认内容可公开时使用）
#
# 拦截目标（都是真实踩过的）：钉钉 Client ID、审批模板真实字段编码、
# 内网域名与内网 IP、共享盘 UNC 路径、真实 unionId。

set -eu

gitdir=$(git rev-parse --git-dir)
report="$gitdir/pre-commit-report.txt"
: > "$report"

git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.pdf|*.docx|*.xlsx|*.pptx|*.zip|*.7z|*.gz) continue ;;
  esac

  # 1) 钉钉 Client ID: ding + 16 位小写字母数字
  # 2) 审批模板真实字段编码（占位写法 TextField_<编码> 不会命中）
  # 3) 组织内网域名（gitlab 本仓库地址属公开信息，放行）
  # 4) 具体内网 IP（放行 192.168.0.0/16 这类网段写法）
  # 5) 带 IP 的共享盘 UNC 路径
  # 6) 真实 unionId 赋值
  {
    grep -nEI 'ding[a-z0-9]{16}' "$f" 2>/dev/null || true
    grep -nEI '(TextField|DDSelectField|InnerContactField|DDDateField|NumberField|TextareaField|AttachmentField|AddressField)[_-][A-Za-z0-9]{6,}' "$f" 2>/dev/null || true
    grep -nEI '[a-z0-9-]+\.idrl\.ac\.cn' "$f" 2>/dev/null | grep -v 'gitlab\.idrl\.ac\.cn' || true
    grep -nEI '192\.168\.[0-9]{1,3}\.[0-9]{1,3}' "$f" 2>/dev/null | grep -v '/16' || true
    grep -nEI '\\\\[0-9]{1,3}(\.[0-9]{1,3}){3}\\[A-Za-z]' "$f" 2>/dev/null || true
    grep -nEI 'unionId["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9]{16,}' "$f" 2>/dev/null || true
  } | sort -u | sed "s|^|$f:|" >> "$report"
done

if [ -s "$report" ]; then
  echo "" >&2
  echo "[pre-commit] 阻断：以下位置含疑似组织内部实值" >&2
  sed 's/^/    /' "$report" >&2
  cat >&2 <<'EOF'

实值只放包外私有文件（例：%USERPROFILE%\_private\<项目>\instance-values.md），
skill 目录内一律用 <占位符>。确认可公开时可 git commit --no-verify 绕过。
EOF
  rm -f "$report"
  exit 1
fi

rm -f "$report"
exit 0
