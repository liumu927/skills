# 边界中间件（形态 B）环境变量
#
# 用法：cp .env.example /etc/dingtalk-relay/.env && chmod 600 /etc/dingtalk-relay/.env
# 该文件含令牌明文：0600、属主为服务账号、不进仓库、不进镜像。
#
# 命名规范：consumer = <系统>-<环境>，如 <system>-prod / assets-test
# 一个 consumer 只对应一个系统的一个数据方向。

# ---------- 网络 ----------
# 只监听本机，前面必须挂 nginx（TLS 终结）。不要改成 0.0.0.0。
HOST=127.0.0.1
PORT=4330

# ---------- 存储 ----------
DATA_DIR=/var/lib/dingtalk-relay
# 单条请求体上限（与 nginx client_max_body_size 对齐）
MAX_BODY_BYTES=262144
# 已投递记录的保留天数（合规要求通常 30~90，涉个人信息取短）
RETENTION_DAYS=60
# 每累计多少条日志事件压缩一次快照
COMPACT_EVERY=5000

# ---------- 投递语义 ----------
# 租约秒数：内网处理一批的时间上限，超时会重投（消费端必须幂等）
LEASE_SECONDS=60
# 超过多少次 nack 转 dead（要人工看，不要无限重试）
MAX_ATTEMPTS=8

# ---------- 鉴权（三套令牌互相独立）----------
# 钉钉连接器请求头 X-API-Token 里的值：consumer:token,consumer2:token2
# 轮换做法：先加新值（用两个 consumer 别名的过渡期），观察无 401 后删旧值。
EDGE_TOKENS=<system>-prod:CHANGE_ME_EDGE_1
# 内网拉取器用的 Bearer 令牌：consumer:token,consumer2:token2
# 与 EDGE_TOKENS 不同值，泄露一个不影响另一个。
CONSUMER_TOKENS=<system>-prod:CHANGE_ME_CONSUMER_1
# 运维接口令牌（/api/admin/*）。留空 = 关闭 admin 接口。
ADMIN_TOKEN=CHANGE_ME_ADMIN

# ---------- 拉取器（内网侧，puller/.env 用，不是本机 relay 的配置）----------
# EDGE_BASE=https://<domain>
# CONSUMER=<system>-prod
# CONSUMER_TOKEN=<与 CONSUMER_TOKENS 里该 consumer 相同>
# PULL_LIMIT=20
# PULL_LEASE=60
# PULL_INTERVAL_MS=30000
# LOCAL_DIR=/opt/dingtalk-puller/data
